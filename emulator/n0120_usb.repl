// Minimal USB1 OTG-HS idle status for stock early initialization.

n0120Usb1OtgHs: Python.PythonPeripheral @ sysbus 0x40040000
    size: 0x1000
    initable: true
    script: '''
if request.IsInit:
    regs = [0] * 1024
    regs[4] = 0x80000000
elif request.IsWrite:
    regs[request.Offset >> 2] = request.Value
    if request.Offset == 0x10:
        regs[4] = (request.Value & 0xFFFFFFFE) | 0x80000000
elif request.IsRead:
    request.Value = regs[request.Offset >> 2]
'''
