// SPDX-License-Identifier: GPL-3.0-only
// The H743 base binds EXTI to its SYSCFG instance. Replacing SYSCFG therefore
// requires recreating the same hardware chain rather than a register-only stub.
n0120Exti: IRQControllers.STM32H7_EXTI @ sysbus 0x58000000
    [0-4] -> nvic@[6-10]
    [5-9] -> n0120NvicInput23@[0-4]
    [10-15] -> n0120NvicInput40@[0-5]
    [16-19] -> nvic@[1, 41, 2, 3]
    [20, 21] -> n0120NvicInput137@[0-1]
    [22-24] -> nvic@[31, 33, 72]
    [26-29] -> nvic@[37-39, 71]
    [30-33] -> nvic@[52, 53, 82, 83]
    [34-35] -> n0120NvicInput142@[0-1]
    [36-40] -> nvic@[35, 36, 51, 84, 85]
    41 -> n0120NvicInput86@0
    [42-44] -> nvic@[119, 76, 100]
    [47, 48, 50, 52, 53] -> nvic@[93, 138-141]
    54 -> nvic@115
    [55-60] -> n0120NvicInput149@[0-5]
    [61-64] -> nvic@[5, 95, 96, 142]
    65 -> n0120NvicInput86@1
    [66-73] -> nvic@[129-136]
    [74-76] -> nvic@[128, 127, 146]
    [85, 86] -> nvic@[94, 61]

n0120NvicInput23: Miscellaneous.CombinedInput @ none
    numberOfInputs: 5
    -> nvic@23

n0120NvicInput40: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@40

n0120NvicInput86: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@86

n0120NvicInput137: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@137

n0120NvicInput142: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@142

n0120NvicInput149: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@149

n0120Syscfg: N0120Syscfg @ sysbus 0x58000400
    preinit:
        include @n0120_syscfg.cs
    [0-15] -> n0120Exti@[0-15]

gpioPortA:
    [0-15] -> n0120Syscfg#0@[0-15]
gpioPortB:
    [0-15] -> n0120Syscfg#1@[0-15]
gpioPortC:
    [0-15] -> n0120Syscfg#2@[0-15]
gpioPortD:
    [0-15] -> n0120Syscfg#3@[0-15]
gpioPortE:
    [0-15] -> n0120Syscfg#4@[0-15]
gpioPortF:
    [0-15] -> n0120Syscfg#5@[0-15]
gpioPortG:
    [0-15] -> n0120Syscfg#6@[0-15]
gpioPortH:
    [0-15] -> n0120Syscfg#7@[0-15]
gpioPortI:
    [0-15] -> n0120Syscfg#8@[0-15]
gpioPortJ:
    [0-15] -> n0120Syscfg#9@[0-15]
gpioPortK:
    [0-7] -> n0120Syscfg#10@[0-7]
